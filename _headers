# KiranaYap - Cloudflare Pages response headers (https://kiranayap.pages.dev/)
# Docs: https://developers.cloudflare.com/pages/configuration/headers/
# Rules that match the same request are merged, so Cache-Control is only set
# by rules that never overlap.

# Security headers on every response
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# CSS, JS, fonts and vendor files are always requested with ?v=<content hash>
# (tools/version-assets.js; tests/static.test.js fails if one is missing), so a
# changed file always has a new URL and the old one can be cached for a year.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Images are referenced by unversioned names (also from the shop files), so
# they are cached for 1 day only. The service worker refreshes them.
/assets/images/*
  Cache-Control: public, max-age=86400

# Always revalidate the service worker, manifest, shop data and pages.
# Cloudflare Pages also serves "about.html" as "/about", so both forms are listed.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/store/*
  Cache-Control: no-cache
